{
  "name": "svws-import",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build && GSETTINGS_SCHEMA_DIR=$HOME/.local/share/electron-schemas electron . --no-sandbox --ozone-platform=x11",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win nsis",
    "release": "rm -rf release && npm run build && electron-builder --linux AppImage --win nsis; mkdir -p release && cd dist && zip -r ../release/SVWS-Import-$npm_package_version-webserver.zip ."
  },
  "build": {
    "appId": "de.skinwalker.svws-import",
    "productName": "SVWS Import",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SVWS-Import",
      "menuCategory": "SVWS"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@ag-grid-community/client-side-row-model": "^32.3.0",
    "@ag-grid-community/core": "^32.3.0",
    "@ag-grid-community/styles": "^32.3.9",
    "@ag-grid-community/vue3": "^32.3.0",
    "@primevue/themes": "^4.5.4",
    "axios": "^1.8.0",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "papaparse": "^5.5.0",
    "pinia": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.0",
    "read-excel-file": "^9.0.9",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^42.3.1",
    "electron-builder": "^26.8.1",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
